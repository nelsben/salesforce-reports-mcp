{
  "name": "salesforce-reports",
  "version": "0.4.0",
  "description": "Ask Salesforce a question in plain words. Claude runs your reports and turns the answer into a dashboard you can share.",
  "author": { "name": "nelsben" },
  "homepage": "https://github.com/nelsben/salesforce-reports-mcp",
  "repository": "https://github.com/nelsben/salesforce-reports-mcp",
  "license": "MIT",
  "keywords": ["salesforce", "reports", "mcp", "analytics"],
  "skills": "./skills",
  "mcpServers": {
    "salesforce-reports": {
      "command": "npx",
      "args": ["-y", "salesforce-reports-mcp@0.4.0"],
      "env": { "SF_REPORTS_READ_ONLY": "${SF_REPORTS_READ_ONLY:-1}" }
    }
  }
}
