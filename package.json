{
  "name": "salesforce-reports-mcp",
  "version": "0.1.0",
  "description": "MCP server to find, define, run, save and combine Salesforce reports through the Reports and Dashboards REST API",
  "license": "MIT",
  "type": "module",
  "bin": {
    "salesforce-reports-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nelsben/salesforce-reports-mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "live": "tsx scripts/live-check.ts",
    "parity": "tsx scripts/parity-check.ts",
    "capture": "tsx scripts/capture-fixtures.ts",
    "prepare": "tsc",
    "mcp-check": "tsx scripts/mcp-check.ts",
    "mcp:generate": "tsx salesforce/scripts/generate-metadata.ts",
    "mcp:setup": "tsx salesforce/scripts/mcp-setup.ts",
    "mcp:teardown": "tsx salesforce/scripts/mcp-teardown.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
